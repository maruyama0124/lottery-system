# 本番 (Supabase など) は接続文字列を1本で指定する。
# 設定した場合、下の DB_* は無視される
# DATABASE_URL=postgresql://postgres:xxxx@db.xxxx.supabase.co:5432/postgres

# ローカル開発 (docker compose) 用
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=lottery_db
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_MINUTES=43200
PORT=8000
